--[[----------------------------------------------------------------------------------------------------
	Duty Expansion Redux logic framework

	Derived from xr_logic_ex.script by GhenTuong (Duty Expansion).
	Renamed so it can load beside other copies of that script, such as the one in Western Goods.
	Squads opt in with the redux_logic key. Condition and effect names use the redux_ prefix.
------------------------------------------------------------------------------------------------------]]
REDUX_VERSION = "0.1.0-beta"

--[[----------------------------------------------------------------------------------------------------
	Conditions
------------------------------------------------------------------------------------------------------]]
xr_conditions.redux_dist_to_beh = function(actor, npc, p)
    local st = npc and db.storage[npc:id()]
    local dt = st and st.beh and st.beh.desired_target
    if dt and (st.active_section == dt.active_section) and dt.position then
        return p and p[1] and npc:position():distance_to_sqr(dt.position) < p[1] * p[1]
    end
    return false
end

xr_conditions.redux_reach_beh = function(actor, npc, p)
    local st = npc and db.storage[npc:id()]
    local dt = st and st.beh and st.beh.desired_target
    if
        dt
        and (st.active_section == dt.active_section)
        and dt.level_vertex_id
        and (dt.level_vertex_id == npc:level_vertex_id())
    then
        return true
    end
    return false
end

xr_conditions.redux_npc_squad_name = function(actor, npc, p)
    local squad = get_object_squad(npc)
    if p and p[1] and squad and string.find(squad:section_name(), p[1]) then return true end
    return false
end

xr_conditions.redux_enemy_squad = function(enemy, npc, p)
    local squad = get_object_squad(enemy)
    if p and p[1] and squad and string.find(squad:section_name(), p[1]) then return true end
    return false
end

xr_conditions.redux_check_squad_section = function(actor, squad, p)
    if p and p[1] and squad and string.find(squad:section_name(), p[1]) then return true end
    return false
end
xr_effects.redux_squad_self_release = function(actor, squad, p) return squad and squad.id and alife_release(squad) end

xr_conditions.redux_check_time_speech = function(actor, npc, p)
    local st = db.storage[npc:id()]
    local dt = st and st.beh and st.beh.desired_target
    if not (dt and dt.speech_delay_until) then return true end
    if dt.speech_delay_until < time_global() then return true end
    return false
end

xr_effects.redux_speech = function(actor, npc, p)
    local se = npc and (type(npc.id) == "function") and alife_object(npc:id())
    se = se or (npc and (type(npc.id) == "number") and alife_object(npc.id))
    local name = se and se:character_name()
    local text = p and p[1] and game.translate_string(p[1])
    if name and text then
        dynamic_news_helper.send_tip(text, name, nil, 15, "ui_npc_duty_girl_msg_image", nil, "npc")
        if tonumber(p[2]) then
            local st = db.storage[npc:id()]
            local dt = st and st.beh and st.beh.desired_target
            if dt then dt.speech_delay_until = time_global() + tonumber(p[2]) * 1000 end
        end
    end
end

function get_waypoint(npc, section, pt)
    local tonum = tonumber
    local st = npc and db.storage[npc:id()]
    if st and st.ini and (section or st.active_section) and pt and tostring(pt) then
        local str = st.ini:r_string_ex(section or st.active_section, tostring(pt))
        if str then
            for s in string.gmatch(str, "pos:(%A+)") do
                local v = str_explode(s, ",")
                if tonum(v[1]) and tonum(v[2]) and tonum(v[3]) then
                    return vector():set(tonum(v[1]), tonum(v[2]), tonum(v[3]))
                end
            end
        end
    end
end

function set_position(actor, npc, p)
    local pos = p and p[1] and p[2] and get_waypoint(npc, p[1], p[2])
    if pos then npc:set_npc_position(pos) end
end

--[[----------------------------------------------------------------------------------------------------
	Stalker state
------------------------------------------------------------------------------------------------------]]
function state_idle(actor, npc, p)
    local new_state = p and p[1]
    local state = npc and state_mgr.get_state(npc)
    if new_state and state and (new_state ~= state) then state_mgr.set_state(npc, new_state) end
end

--[[----------------------------------------------------------------------------------------------------
	Movement
------------------------------------------------------------------------------------------------------]]
local function validate(npc, vid)
    if vid and vid < 4294967295 and npc:accessible(vid) and vid ~= npc:level_vertex_id() then
        return db.used_level_vertex_ids[vid] == nil or db.used_level_vertex_ids[vid] == npc:id()
    end
    return false
end

local function lmove(npc, vid, st)
    if vid == nil or vid >= 4294967295 then return end

    if db.used_level_vertex_ids[vid] == npc:id() then
        npc:set_dest_level_vertex_id(vid)
        return vid
    end

    if st.vid then db.used_level_vertex_ids[st.vid] = nil end

    if not (npc:accessible(vid)) then
        local vtemp = VEC_ZERO
        vid, vtemp = npc:accessible_nearest(vid and level.vertex_position(vid) or npc:position(), vtemp)
    end

    db.used_level_vertex_ids[vid] = npc:id()
    st.vid = vid

    npc:set_dest_level_vertex_id(vid)
    return vid
end

--[[----------------------------------------------------------------------------------------------------
	Anchors
	Named positions per level, read from anchors.ltx. Only the current level's section is read, so
	level.vertex_id never sees another level's coordinates. Every point resolves to a position, and
	failures are logged once per level load.
------------------------------------------------------------------------------------------------------]]
local ANCHOR_FILE = "scripts\\duty_redux\\anchors.ltx"
local INVALID_VID = 4294967295

local anchor_level = nil
local anchor_table = {}
local anchor_logged = {}

local function log_once(key, fmt, ...)
    if anchor_logged[key] then return end
    anchor_logged[key] = string.format(fmt, ...)
    printf("Redux logic: %s", anchor_logged[key])
end

-- The +0.5 y offset matches the original lookup, so the same floor is picked on stacked geometry.
local function vertex_at(pos) return level.vertex_id(vector():set(pos.x, pos.y + 0.5, pos.z)) end

local function parse_pos(str)
    local tonum = tonumber
    local pos = nil
    for s in string.gmatch(str, "pos:(%A+)") do
        local p = str_explode(s, ",")
        if tonum(p[1]) and tonum(p[2]) and tonum(p[3]) then
            pos = vector():set(tonum(p[1]), tonum(p[2]), tonum(p[3]))
        end
    end
    return pos
end

local function parse_yaw(str)
    local yaw = nil
    for s in string.gmatch(str, "dir:(%A+)") do
        yaw = tonumber(str_explode(s, ",")[1])
    end
    return yaw
end

local function load_anchors()
    local name = level.name()
    if anchor_level == name then return anchor_table end
    anchor_level = name
    anchor_table = {}
    anchor_logged = {}

    local section = "anchors_" .. name
    local ini = ini_file(ANCHOR_FILE)
    if not (ini and ini:section_exist(section)) then return anchor_table end

    local n = ini:line_count(section)
    for k = 0, n - 1 do
        local _, id, v = ini:r_line(section, k)
        local pos = id and v and parse_pos(v)
        if pos then
            local vid = vertex_at(pos)
            anchor_table[id] = {
                pos = pos,
                yaw = parse_yaw(v),
                vid = vid,
                valid = vid < INVALID_VID,
                fallback = string.match(v, "fallback:([%w_]+)"),
            }
            if vid >= INVALID_VID then log_once("level:" .. id, "anchor [%s] %s is off the nav mesh", section, id) end
        elseif id then
            log_once("parse:" .. id, "anchor [%s] %s has no valid pos:", section, id)
        end
    end

    for id, a in pairs(anchor_table) do
        if a.fallback and not anchor_table[a.fallback] then
            log_once("fallback:" .. id, "anchor [%s] %s has unknown fallback %s", section, id, a.fallback)
        end
    end

    return anchor_table
end

local function point_ok(npc, vid, check_access)
    return vid and vid < INVALID_VID and ((not check_access) or npc:accessible(vid))
end

-- Resolves the anchor: or pos: tag of a pt string. Returns nil only when the string has neither tag.
-- Otherwise returns position, level vertex id, anchor yaw and how it resolved: ok, fallback, nearest
-- or current. check_access adds the per-NPC npc:accessible check, which net spawn skips.
function resolve_point(npc, str, section, pt, check_access)
    local anchors = load_anchors()
    local name = string.match(str, "anchor:([%w_]+)")
    local raw = parse_pos(str)
    local a, pos, vid, yaw, key

    if name then
        if raw then
            log_once(
                "both:" .. section .. ":" .. pt,
                "[%s] %s has both anchor: and pos:, using the anchor",
                section,
                pt
            )
        end
        a = anchors[name]
        if not a then log_once("unknown:" .. name, "unknown anchor %s on %s", name, tostring(anchor_level)) end
        pos, vid, yaw = a and a.pos, a and a.vid, a and a.yaw
        key = npc:id() .. ":" .. name
    elseif raw then
        pos, vid = raw, vertex_at(raw)
        key = section .. ":" .. pt
    else
        return
    end

    if point_ok(npc, vid, check_access) then return vector():set(pos), vid, yaw, "ok" end

    local fb = a and a.fallback and anchors[a.fallback]
    if fb and point_ok(npc, fb.vid, check_access) then
        log_once(key, "%s [%s] %s uses fallback anchor %s", npc:name(), section, pt, a.fallback)
        return vector():set(fb.pos), fb.vid, fb.yaw or yaw, "fallback"
    end

    local base = (vid and vid < INVALID_VID and vid) or (fb and fb.vid < INVALID_VID and fb.vid)
    if base then
        local nearest = npc:accessible_nearest(level.vertex_position(base), vector())
        if nearest and nearest < INVALID_VID then
            log_once(key, "%s [%s] %s uses nearest accessible vertex %s", npc:name(), section, pt, nearest)
            return vector():set(level.vertex_position(nearest)), nearest, yaw, "nearest"
        end
    end

    log_once(key, "%s [%s] %s has no valid position, standing at current vertex", npc:name(), section, pt)
    return vector():set(npc:position()), npc:level_vertex_id(), yaw, "current"
end

-- Formats one log line. The result goes through printf("%s", ...) so a % in a name never reaches the engine format.
local function logf(fmt, ...) printf("%s", string.format("Redux logic: " .. fmt, ...)) end

-- Debug console: run_string duty_redux_logic.debug_anchors()
function debug_anchors()
    local anchors = load_anchors()
    local names = {}
    for id in pairs(anchors) do
        names[#names + 1] = id
    end
    table.sort(names)

    logf("%s anchors on %s", #names, tostring(anchor_level))
    for _, id in ipairs(names) do
        local a = anchors[id]
        logf(
            "%s pos=%.3f,%.3f,%.3f yaw=%s vid=%s valid=%s fallback=%s",
            id,
            a.pos.x,
            a.pos.y,
            a.pos.z,
            tostring(a.yaw),
            tostring(a.vid),
            tostring(a.valid),
            tostring(a.fallback)
        )
    end
    for _, msg in pairs(anchor_logged) do
        logf("logged: %s", msg)
    end
end

--[[----------------------------------------------------------------------------------------------------
	Anna diagnostics
	debug_anna() prints her state in one call. It runs from the console, once per level entry when she
	is online, and once per duty_girl_* info token given. It never runs per tick.
------------------------------------------------------------------------------------------------------]]
local ANNA_SQUAD = "squad_duty_girl"
local ANNA_STORY_ID = "stalker_duty_girl"
local ANNA_TOKENS = {
    "duty_girl_init",
    "duty_girl_first_meet",
    "duty_girl_hunting_chimera_init",
    "duty_girl_hunting_chimera_move",
    "duty_girl_hunting_chimera_fight",
    "duty_girl_hunting_chimera_dead",
    "duty_girl_hunting_chimera_done",
    "duty_girl_hunting_chimera_fail",
    "duty_girl_hunting_chimera_reward",
    "duty_girl_monolith_elite_init",
    "duty_girl_monolith_elite_move",
    "duty_girl_monolith_elite_join",
    "duty_girl_monolith_elite_dead",
    "duty_girl_monolith_elite_done",
    "duty_girl_monolith_elite_fail",
    "duty_girl_monolith_elite_reward",
    "duty_girl_monolith_elite_supply",
    "duty_girl_loot_stash_init",
    "duty_girl_loot_stash_done",
    "duty_girl_capture_the_bridge_init",
    "duty_girl_capture_the_bridge_move",
    "duty_girl_capture_the_bridge_join",
    "duty_girl_capture_the_bridge_dead",
    "duty_girl_capture_the_bridge_done",
    "duty_girl_capture_the_bridge_fail",
    "duty_girl_capture_the_bridge_reward",
    "duty_girl_capture_the_bridge_supply",
}

local anna_level_logged = false

local function object_name(obj) return obj and obj:name() or "none" end

local function danger_text(npc)
    local danger = npc:best_danger()
    if not danger then return "none" end
    return string.format("%s type=%s", object_name(danger:object()), tostring(danger:type()))
end

local function level_of(se_obj) return alife():level_name(game_graph():vertex(se_obj.m_game_vertex_id):level_id()) end

local function build_anna_lines(add)
    local squad = get_story_se_object(ANNA_SQUAD)
    local se_npc = get_story_se_object(ANNA_STORY_ID)
    if not (squad or se_npc) then
        add("not spawned (no squad or object for %s)", ANNA_STORY_ID)
        return
    end

    local se = se_npc or squad
    add(
        "squad id=%s object id=%s online=%s level=%s",
        tostring(squad and squad.id),
        tostring(se_npc and se_npc.id),
        tostring(se.online),
        level_of(se)
    )

    local npc = se_npc and se.online and level.object_by_id(se_npc.id)
    local st = se_npc and db.storage[se_npc.id]
    if not (npc and st) then
        add("offline, no object state to read")
    else
        local mgr = st.state_mgr
        local marker = mgr and mgr.animation and mgr.animation.states and mgr.animation.states.anim_marker
        local item, weapon = npc:active_item(), npc:best_weapon()
        add("section_logic=%s active_section=%s", tostring(st.section_logic), tostring(st.active_section))
        add("target_state=%s anim_marker=%s", tostring(mgr and mgr.target_state), tostring(marker))
        add("active_item=%s best_weapon=%s", item and item:section() or "none", weapon and weapon:section() or "none")
        add("best_enemy=%s best_danger=%s", object_name(npc:best_enemy()), danger_text(npc))
    end

    local set = {}
    for _, token in ipairs(ANNA_TOKENS) do
        if has_alife_info(token) then set[#set + 1] = token end
    end
    add("info tokens set (%s): %s", #set, #set > 0 and table.concat(set, ", ") or "none")
end

-- Debug console: run_string duty_redux_logic.debug_anna()
-- Never throws. Offline or unspawned states print what is known, and an unexpected error prints as a line.
function debug_anna(reason)
    local lines = {}
    local function add(fmt, ...) lines[#lines + 1] = string.format(fmt, ...) end

    add("anna debug (%s), Duty Expansion Redux %s", tostring(reason or "console"), REDUX_VERSION)
    local ok, err = pcall(build_anna_lines, add)
    if not ok then add("anna debug failed: %s", tostring(err)) end

    for _, line in ipairs(lines) do
        logf("%s", line)
    end
end

-- Runs from squad_on_update and fires once per level, on the first update after her squad is online.
-- It does not wait for an active section, so the log shows a missing one.
local function log_level_entry(squad)
    if anna_level_logged or squad.online ~= true or squad:section_name() ~= ANNA_SQUAD then return end
    anna_level_logged = true
    debug_anna("level entry")
end

local function actor_on_info_callback(obj, info_id)
    if type(info_id) == "string" and string.find(info_id, "^duty_girl_") then debug_anna("info " .. info_id) end
end

--[[----------------------------------------------------------------------------------------------------
	Animpoints
------------------------------------------------------------------------------------------------------]]
local campfire_state_tbl = {
    idle = {
        director = {
            "",
            "_eat_bread",
            "_eat_kolbasa",
            "_drink_vodka",
            "_drink_energy",
            "_weapon",
            "_roast_kolbasa",
            "_roast_kolbasa_bred",
            "_roast_bred",
            "_sleep",
            "_use_pda",
        },
        listener = {
            "",
            "_eat_bread",
            "_eat_kolbasa",
            "_drink_vodka",
            "_drink_energy",
            "_weapon",
            "_roast_kolbasa",
            "_roast_kolbasa_bred",
            "_roast_bred",
            "_sleep",
            "_use_pda",
        },
    },
    harmonica = {
        director = { "_harmonica" },
        listener = {
            "",
            "_eat_bread",
            "_eat_kolbasa",
            "_drink_vodka",
            "_drink_energy",
            "_weapon",
            "_roast_kolbasa",
            "_roast_kolbasa_bred",
            "_roast_bred",
            "_sleep",
            "_use_pda",
        },
    },
    guitar = {
        director = { "_guitar" },
        listener = {
            "",
            "_eat_bread",
            "_eat_kolbasa",
            "_drink_vodka",
            "_drink_energy",
            "_weapon",
            "_roast_kolbasa",
            "_roast_kolbasa_bred",
            "_roast_bred",
            "_sleep",
            "_use_pda",
        },
    },
    story = {
        director = { "", "_weapon" },
        listener = {
            "",
            "_eat_bread",
            "_eat_kolbasa",
            "_drink_vodka",
            "_drink_energy",
            "_weapon",
            "_roast_kolbasa",
            "_roast_kolbasa_bred",
            "_roast_bred",
            "_sleep",
            "_use_pda",
        },
    },
}

local state_sit_all = { "animpoint_sit", "animpoint_sit_ass", "animpoint_sit_knee" }

function xr_effects.redux_animpoint(actor, npc)
    local mrandom = math.random
    local pairs_ = pairs
    local st = npc and db.storage[npc:id()]
    local beh = st and st.beh
    if not beh then return end
    local dt = beh.desired_target

    if not (dt and (st.active_section == dt.active_section) and (dt.custom_logic == "animpoint")) then
        local index = next_pt_index(npc)
        dt = load_animpoint(npc, index)
    end

    if dt and dt.wait_delay and (dt.wait_delay < time_global()) then
        local index = next_pt_index(npc)
        dt = load_animpoint(npc, index)
    end

    -- load_animpoint already logged the missing point once.
    if not dt.level_vertex_id then return end

    if st.beh.use_camp and dt.animpoint then
        -- Move to camp
        if npc:level_vertex_id() ~= dt.level_vertex_id then
            npc:set_path_type(game_object.level_path)
            npc:set_desired_direction()
            beh.assist_point =
                utils_obj.send_to_nearest_accessible_vertex(npc, dt.level_vertex_id, "xr_custom.animpoint")
            set_moving_state(npc)
            return
        end

        -- Get camp
        if not beh.camp then beh.camp = sr_camp.get_current_camp(dt.position) end
        if beh.camp and not beh.in_camp then
            beh.camp:register_npc(npc:id())
            beh.in_camp = true
        end

        if not (dt.approved_actions and (#dt.approved_actions > 0)) then
            local is_in_camp = beh.camp ~= nil
            local p = { "animpoint_sit_ass", "animpoint_sit_knee", "animpoint_sit" }
            dt.description_name = p[mrandom(#p)]
            dt.avail_actions = xr_animpoint_predicates.associations[dt.description_name]

            if dt.avail_actions then
                local lst = {}
                for k, v in pairs_(dt.avail_actions) do
                    -- Skip animpoint_sit_ass_use_pda. Its item_5 motions are missing from GAMMA's stalker_animation.omf.
                    if v.name ~= "animpoint_sit_ass_use_pda" and v.predicate(npc:id(), is_in_camp) == true then
                        lst[#lst + 1] = v
                    end
                end
                dt.approved_actions = lst
            else
                return
            end
        end

        local tmp_actions = {}
        local num = 0

        local camp_action, is_director = beh.camp and beh.camp:get_camp_action(npc:id())
        if not camp_action then return end

        local tbl = nil
        if is_director then
            tbl = campfire_state_tbl[camp_action].director
            dt.__dtimer = time_global()
        else
            dt.__dtimer = (not dt.__dtimer and time_global() + mrandom(10000, 15000)) or dt.__dtimer
            if dt.current_action and time_global() < dt.__dtimer then return end
            tbl = campfire_state_tbl[camp_action].listener
        end

        local found = false
        for k, v in pairs_(dt.approved_actions) do
            for i = 1, #tbl do
                if dt.description_name .. tbl[i] == v.name then
                    num = num + 1
                    tmp_actions[num] = v.name
                    found = true
                end
            end
        end

        if not found then
            num = num + 1
            tmp_actions[num] = dt.description_name
        end

        dt.current_action = tmp_actions[mrandom(num)]

        local cur_state = state_mgr.get_state(npc)
        local new_state = dt.current_action
        if cur_state and new_state and (cur_state ~= new_state) then
            local anim_pos = dt.animpoint and vector():set(dt.animpoint)
            local anim_dir = dt.direction and vector():set(dt.direction)
            state_mgr.set_state(
                npc,
                new_state,
                nil,
                nil,
                nil,
                { animation_position = anim_pos, animation_direction = anim_dir }
            )
        end
        return
    end

    if dt.animpoint then
        local cur_state = state_mgr.get_state(npc)
        local new_state = nil

        if dt.delay_animation and string.find(dt.delay_animation, "@random", 1, true) then
            if dt.random_animation == nil then
                local str = str_explode(dt.delay_animation, "@")
                local state_base = tostring(str[1])
                state_base = (
                    string.find(state_base, "animpoint_sit_all", 1, true) and state_sit_all[mrandom(#state_sit_all)]
                ) or state_base

                local p = { "guitar", "harmonica", "roast", "weapon" }
                local function check_state_exception(state_con, state)
                    for k, v in pairs(p) do
                        if string.find(state, v) and not string.find(state_con, v) then return false end
                    end
                    return true
                end

                local state_list = {}
                local t = xr_animpoint_predicates.associations[state_base]
                if t then
                    for k, v in pairs_(t) do
                        if v.name and check_state_exception(dt.delay_animation, tostring(v.name)) then
                            state_list[#state_list + 1] = tostring(v.name)
                        end
                    end
                end

                if #state_list == 0 then
                    printf("Redux logic: can not find %s %s", dt.active_section, dt.delay_animation)
                    return
                end
                dt.random_animation = state_list[mrandom(#state_list)]
            end
            new_state = dt.random_animation
        else
            new_state = dt.delay_animation
        end

        if not (cur_state and new_state) then return end

        if (cur_state == new_state) and (npc:position():distance_to_sqr(dt.animpoint) < 0.8) then
            if dt.delay then
                if not dt.wait_delay then dt.wait_delay = time_global() + dt.delay end
            end

            if dt.sound_idle then xr_sound.set_sound_play(npc:id(), dt.sound_idle) end
            return
        end

        if npc:level_vertex_id() ~= dt.level_vertex_id then
            npc:set_path_type(game_object.level_path)
            npc:set_desired_direction()
            beh.assist_point =
                utils_obj.send_to_nearest_accessible_vertex(npc, dt.level_vertex_id, "xr_custom.animpoint")
            set_moving_state(npc)
            return
        end

        if cur_state == new_state then
            if dt.delay then
                if not dt.wait_delay then dt.wait_delay = time_global() + dt.delay end
            end

            if dt.sound_idle then xr_sound.set_sound_play(npc:id(), dt.sound_idle) end
            return
        end

        local reach_state = "animpoint_reach_ex"

        if (cur_state ~= new_state) and (cur_state ~= reach_state) then
            local anim_pos = dt.animpoint and vector():set(dt.animpoint)
            local anim_dir = dt.direction and vector():set(dt.direction)
            state_mgr.set_state(npc, reach_state, {
                turn_end_func = function() return end,
            }, nil, { look_dir = anim_dir }, { animation_position = anim_pos })
        end

        if (cur_state == reach_state) and not (st.callback and st.callback.turn_end_func) then
            local anim_pos = dt.animpoint and vector():set(dt.animpoint)
            local anim_dir = dt.direction and vector():set(dt.direction)
            --local look_pos = dt.look_position and vector():set(dt.look_position)
            state_mgr.set_state(
                npc,
                new_state,
                nil,
                nil,
                nil,
                { animation_position = anim_pos, animation_direction = anim_dir }
            )
        end
        return
    end

    if npc:level_vertex_id() ~= dt.level_vertex_id then
        npc:set_path_type(game_object.level_path)
        npc:set_desired_direction()
        beh.assist_point = utils_obj.send_to_nearest_accessible_vertex(npc, dt.level_vertex_id, "xr_custom.animpoint")
        set_moving_state(npc)
        return
    end

    local cur_state = state_mgr.get_state(npc)
    local new_state = dt.delay_animation
    if not (cur_state and new_state) then return end

    if cur_state == new_state then
        if dt.delay then
            if not dt.wait_delay then dt.wait_delay = time_global() + dt.delay end
        end

        if dt.sound_idle then xr_sound.set_sound_play(npc:id(), dt.sound_idle) end
        return
    end

    local look_pos = dt.look_position and vector():set(dt.look_position)
    state_mgr.set_state(npc, new_state, nil, nil, { look_position = look_pos })
end

function load_animpoint(npc, index)
    local sgmatch = string.gmatch
    local tonum = tonumber
    local st = npc and db.storage[npc:id()]
    if not (st and st.beh and st.ini and st.active_section) then return {} end
    local str = st.ini:r_string_ex(st.active_section, "pt" .. index)

    local dt = {}
    dt.active_section = tostring(st.active_section)
    dt.custom_logic = "animpoint"
    dt.path_index = tonum(index)

    -- Store the empty result too, so a missing point is not reloaded and logged every tick.
    local yaw = nil
    if str then
        dt.position, dt.level_vertex_id, yaw = resolve_point(npc, str, dt.active_section, "pt" .. index, true)
    end
    if not dt.position then
        log_once(
            "nopt:" .. dt.active_section .. ":" .. index,
            "[%s] pt%s has no anchor: or pos:",
            dt.active_section,
            index
        )
        st.beh.desired_target = dt
        return dt
    end

    if string.find(str, "animpoint:pos", 1, true) then
        dt.animpoint = dt.position and vector():set(dt.position)
    else
        for s in sgmatch(str, "animpoint:(%A+)") do
            local p = str_explode(s, ",")
            dt.animpoint = vector():set(tonum(p[1]), tonum(p[2]), tonum(p[3]))
        end
    end

    for s in sgmatch(str, "dir:(%A+)") do
        local p = str_explode(s, ",")
        dt.direction = tonum(p[1]) and vector_rotate_y(vector():set(0, 0, 1), tonum(p[1])):normalize()
    end
    -- A dir: on the pt line overrides the anchor's yaw.
    if not dt.direction and yaw then dt.direction = vector_rotate_y(vector():set(0, 0, 1), yaw):normalize() end

    local pos = dt.animpoint and vector():set(dt.animpoint) or dt.position and vector():set(dt.position)
    local dir = dt.direction and vector():set(dt.direction)
    if pos and dir then dt.look_position = vector():set(pos.x + 10 * dir.x, pos.y, pos.z + 10 * dir.z) end

    if not (dt.direction and dt.look_position) then
        for s in sgmatch(str, "look:(%A+)") do
            local p = str_explode(s, ",")
            dt.look_position = vector():set(tonum(p[1]), tonum(p[2]), tonum(p[3]))
        end
        if pos and dt.look_position then dt.direction = vector():set(dt.look_position):sub(pos):normalize() end
    end

    local pt = str_explode(str, "|")
    pt = pt[1] and str_explode(pt[1], ",")

    if pt then
        if pt[1] and (pt[1] ~= "") and (pt[1] ~= "nil") then dt.delay = tonum(pt[1]) end

        if pt[2] and (pt[2] ~= "") and (pt[2] ~= "nil") then dt.delay_animation = tostring(pt[2]) end

        if pt[3] and (pt[3] ~= "") and (pt[3] ~= "nil") then dt.sound_idle = tostring(pt[3]) end
    end

    st.beh.desired_target = dt
    return st.beh.desired_target
end

function next_pt_index(npc)
    local st = npc and db.storage[npc:id()]
    local dt = st and st.beh and st.beh.desired_target
    local index = (dt and (st.active_section == dt.active_section) and tonumber(dt.path_index) or 0) + 1
    if st.ini and st.active_section and st.ini:r_string_ex(st.active_section, "pt" .. index) then return index end
    return 1
end

function set_moving_state(npc)
    local beh = db.storage[npc:id()] and db.storage[npc:id()].beh
    if not beh then return end

    local t = time_global()
    if beh.keep_state_until and t < beh.keep_state_until then return end
    beh.keep_state_until = t + 500

    local new_state = beh.run_animation
    local dist_w = tonumber(xr_logic.pick_section_from_condlist(db.actor, npc, beh.walk_dist) or 5) or 5
    local dist_j = tonumber(xr_logic.pick_section_from_condlist(db.actor, npc, beh.jog_dist) or 10) or 10

    local pos = vector():set(npc:position())
    local d = beh.desired_target and beh.desired_target.position and pos:distance_to_sqr(beh.desired_target.position)

    if beh.assist_point == nil or beh.assist_point == npc:level_vertex_id() then
        new_state = beh.wait_animation
    elseif (dist_w ~= 0) and d and (d < dist_w * dist_w) then
        new_state = beh.walk_animation
    elseif (dist_j ~= 0) and d and (d > dist_j * dist_j) then
        new_state = beh.jog_animation
    end

    state_mgr.set_state(npc, new_state, nil, nil, nil, { fast_set = true, animation = true })
end

