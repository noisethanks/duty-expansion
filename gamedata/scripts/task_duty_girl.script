local HI = duty_girl_utils.HI
local GI = duty_girl_utils.GI
local NI = duty_girl_utils.NI

local function make_speech_sequence(entries)
    return function()
        local npc = get_story_object("stalker_duty_girl")
        if npc and db.actor then
            for _, p in ipairs(entries) do
                if NI(p[1]) and xr_conditions.redux_check_time_speech(db.actor, npc) then
                    GI(p[1])
                    xr_effects.redux_speech(db.actor, npc, { p[1], p[2] })
                end
            end
        end
        if HI(entries[#entries][1]) then return true end
    end
end

local function squad_count(sq) return sq and sq:npc_count() or 0 end

local function spawn_squad(smart_name, sec) return SIMBOARD:create_squad(SIMBOARD.smarts_by_names[smart_name], sec) end

--[[----------------------------------------------------------------------------------------------------
	duty_girl_hunting_chimera
------------------------------------------------------------------------------------------------------]]
function duty_girl_hunting_chimera_status(tsk, task_id)
    local sec = "squad_duty_girl_hunting_chimera"
    if tsk.stage == 0 then
        if HI("duty_girl_hunting_chimera_move") then
            local smart = SIMBOARD.smarts_by_names["gar_smart_terrain_2_4"]
            local squad = SIMBOARD:create_squad(smart, sec)
            tsk.stage = 1
        end
    end

    if tsk.stage == 1 then
        local squad = get_story_se_object(sec)
        if not squad then
            local message = make_speech_sequence({ { "duty_girl_hunting_chimera_hunt_4", 5 } })
            local npc = get_story_object("stalker_duty_girl")
            if npc then CreateTimeEvent(npc:id(), "speech", 0, message) end
            tsk.stage = 2
        end
    end

    if tsk.stage == 2 then
        if NI("duty_girl_hunting_chimera_dead") then GI("duty_girl_hunting_chimera_dead") end
        if HI("duty_girl_hunting_chimera_reward") then return "complete" end
    end
end

function duty_girl_hunting_chimera_target(task_id, field, p, tsk)
    if field == "title" then return task_id .. "_" .. field end

    if field == "descr" then
        if tsk.stage == 0 then return task_id .. "_" .. field .. "_1" end
        if tsk.stage == 1 then return task_id .. "_" .. field .. "_2" end
        if tsk.stage == 2 then return task_id .. "_" .. field .. "_3" end
    end

    if field == "target" then
        if tsk.stage == 0 then
            local obj = SIMBOARD.smarts_by_names["gar_smart_terrain_6_3"]
            return obj and obj.id
        end
        if (tsk.stage == 1) or (tsk.stage == 2) then
            local obj = get_story_se_object("squad_duty_girl")
            return obj and obj.id
        end
    end
end

function hunting_chimera_hit(npc, shit, bone_id, flags)
    if shit and shit.draftsman and IsStalker(shit.draftsman) then
        if shit.draftsman:id() == AC_ID then
            if NI("duty_girl_hunting_chimera_fight") then GI("duty_girl_hunting_chimera_fight") end
            return
        end
        if
            shit.draftsman:has_info("npcx_is_companion")
            or string.find(shit.draftsman:name(), "stalker_duty_girl", 1, true)
        then
            if NI("duty_girl_hunting_chimera_fight") then GI("duty_girl_hunting_chimera_fight") end
            shit.power = shit.power / 2
            return
        end
    end
    flags.ret_value = false
end

--[[----------------------------------------------------------------------------------------------------
	duty_girl_monolith_elite
------------------------------------------------------------------------------------------------------]]
function duty_girl_monolith_elite_status(tsk, task_id)
    if tsk.stage == 0 then
        spawn_squad("mil_smart_terrain_2_6", "squad_duty_girl_monolith_elite_mono")
        spawn_squad("mil_smart_terrain_4_5", "squad_duty_girl_monolith_elite_duty")
        tsk.stage = 1
    end

    if (tsk.stage == 1) or (tsk.stage == 2) then
        local squad = get_story_se_object("squad_duty_girl_monolith_elite_mono")
        local mem_num = squad_count(squad)
        if mem_num ~= 0 then
            -- Player attack without order
            if mem_num < 8 then
                if NI("duty_girl_monolith_elite_move") then
                    GI("duty_girl_monolith_elite_move")
                    if NI("duty_girl_monolith_elite_join") then GI("duty_girl_monolith_elite_join") end
                    local message = make_speech_sequence({
                        { "duty_girl_monolith_elite_move_5", 5 },
                        { "duty_girl_monolith_elite_move_6", 5 },
                    })
                    local npc = get_story_object("stalker_duty_girl")
                    if npc then CreateTimeEvent(npc:id(), "speech", 0, message) end
                end
            end
        else
            -- Squad is killed
            local message = make_speech_sequence({ { "duty_girl_monolith_elite_move_4", 5 } })
            local npc = get_story_object("stalker_duty_girl")
            if npc then CreateTimeEvent(npc:id(), "speech", 0, message) end
            tsk.stage = 3
        end

        if tsk.stage == 1 then
            if HI("duty_girl_monolith_elite_move") then tsk.stage = 2 end
        end
    end

    if tsk.stage == 3 then
        if NI("duty_girl_monolith_elite_dead") then GI("duty_girl_monolith_elite_dead") end
        if HI("duty_girl_monolith_elite_reward") then return "complete" end
    end
end

function duty_girl_monolith_elite_target(task_id, field, p, tsk)
    if field == "title" then return task_id .. "_" .. field end

    if field == "descr" then
        if (tsk.stage == 0) or (tsk.stage == 1) then return task_id .. "_" .. field .. "_1" end
        if tsk.stage == 2 then return task_id .. "_" .. field .. "_2" end
        if tsk.stage == 3 then return task_id .. "_" .. field .. "_3" end
    end

    if field == "target" then
        if (tsk.stage == 0) or (tsk.stage == 1) then
            local obj = get_story_se_object("squad_duty_girl")
            local sqd = get_story_se_object("squad_duty_girl_monolith_elite_duty")
            if obj and sqd and simulation_objects.is_on_the_same_level(obj, sqd) then return obj.id end
            return sqd and sqd.id
        end
        if tsk.stage == 2 then
            local obj = SIMBOARD.smarts_by_names["mil_smart_terrain_2_6"]
            return obj and obj.id
        end
        if tsk.stage == 3 then
            local obj = get_story_se_object("squad_duty_girl")
            return obj and obj.id
        end
    end
end

function monolith_elite_hit(npc, shit, bone_id, flags)
    if shit and shit.draftsman and IsStalker(shit.draftsman) then
        if shit.draftsman:id() == AC_ID then return end
        if
            IsStalker(shit.draftsman) and shit.draftsman:has_info("npcx_is_companion")
            or string.find(shit.draftsman:name(), "stalker_duty_girl", 1, true)
        then
            shit.power = shit.power / 4
            return
        end
        local squad = get_object_squad(shit.draftsman)
        if squad and string.find(squad:section_name(), "squad_duty_girl_monolith_elite", 1, true) then
            if string.find(npc:name(), "monolith", 1, true) then
                shit.power = shit.power / 4
            else
                shit.power = shit.power / 2
            end
            return
        end
    end
    flags.ret_value = false
end

--[[----------------------------------------------------------------------------------------------------
	duty_girl_loot_stash
------------------------------------------------------------------------------------------------------]]
function duty_girl_loot_stash_status(tsk, task_id)
    local actor = db.actor
    local sim = alife()
    if tsk.stage == 0 then
        local sm = SIMBOARD.smarts_by_names["val_smart_terrain_1_2"]
        local pos = vector():set(175.7, 1, -278.6)
        if sm then
            local player_com = get_actor_true_community()
            local loot_table = duty_girl_loot_get_stuff_table()
            local wpn_table = duty_girl_loot_get_weapon_table()
            local ammo_table = duty_girl_loot_get_ammo_table()
            for i, v in pairs(loot_table[player_com]) do
                sim:create(v, pos, sm.m_level_vertex_id, sm.m_game_vertex_id)
            end
            local rnd_id = rnd_id_from_table(wpn_table[player_com])
            local spawned_wpn = wpn_table[player_com][rnd_id]
            local spawned_ammo = ammo_table[player_com][rnd_id]
            if spawned_ammo ~= "ammo_none" then
                for i = 1, 5 do
                    sim:create(spawned_ammo, pos, sm.m_level_vertex_id, sm.m_game_vertex_id)
                end
            end
            local se = sim:create(spawned_wpn, pos, sm.m_level_vertex_id, sm.m_game_vertex_id)
            if se and spawned_wpn then
                save_var(actor, task_id, se.id)
                save_var(actor, "duty_girl_spawned_weapon", spawned_wpn)
            end
        end
        tsk.stage = 1
    end

    if tsk.stage == 1 then
        local id = load_var(actor, task_id)
        local wpn = load_var(actor, "duty_girl_spawned_weapon")
        local freedom_setup = load_var(actor, "duty_girl_freedom_setup")
        local player_com = get_actor_true_community()
        local se = id and sim:object(id)
        if not (se and wpn and IsWeapon(se) and string.find(se:name(), wpn, 1, true) and (se.parent_id == 65535)) then
            return "complete"
        end
        local obj = level.object_by_id(se.id)
        if obj and not freedom_setup and player_com == "freedom" then
            obj:set_condition(0.05)
            obj:set_ammo_elapsed(1)
            save_var(actor, "duty_girl_freedom_setup", true)
        end
    end
end

function duty_girl_loot_stash_target(task_id, field, p, tsk)
    if field == "title" then return task_id .. "_" .. field end

    if field == "descr" then return task_id .. "_" .. field .. "_1" end

    if field == "target" then
        local id = load_var(db.actor, task_id)
        local se = id and alife():object(id)
        return se and se.id
    end
end

local LOOT_FACTIONS = {
    "stalker",
    "bandit",
    "csky",
    "dolg",
    "freedom",
    "killer",
    "army",
    "ecolog",
    "monolith",
    "renegade",
    "greh",
    "isg",
}

local function read_faction_list_table(section, fallback_item)
    local tbl = {}
    if ini_sys:section_exist(section) then
        local n = ini_sys:line_count(section)
        for k = 0, n - 1 do
            local _, faction, str = ini_sys:r_line(section, k)
            if faction and str then
                local list = parse_names(str)
                if list and #list > 0 then tbl[faction] = list end
            end
        end
    end
    local default = tbl["stalker"] or { fallback_item }
    for _, faction in ipairs(LOOT_FACTIONS) do
        if not tbl[faction] then tbl[faction] = default end
    end
    return tbl
end

local function build_weapon_ammo_tables()
    local wpn_raw, ammo_raw = {}, {}
    if ini_sys:section_exist("duty_girl_loot_weapons") then
        local n = ini_sys:line_count("duty_girl_loot_weapons")
        for k = 0, n - 1 do
            local _, faction, str = ini_sys:r_line("duty_girl_loot_weapons", k)
            if faction and str then
                local list = parse_names(str)
                if list and #list > 0 then wpn_raw[faction] = list end
            end
        end
    end
    if ini_sys:section_exist("duty_girl_loot_ammo") then
        local n = ini_sys:line_count("duty_girl_loot_ammo")
        for k = 0, n - 1 do
            local _, faction, str = ini_sys:r_line("duty_girl_loot_ammo", k)
            if faction and str then
                local list = parse_names(str)
                if list and #list > 0 then ammo_raw[faction] = list end
            end
        end
    end
    local s_wpn = wpn_raw["stalker"]
    local s_ammo = ammo_raw["stalker"]
    local stalker_ok = s_wpn and s_ammo and (#s_wpn == #s_ammo)
    local default_wpn = stalker_ok and s_wpn or { "wpn_ak74m" }
    local default_ammo = stalker_ok and s_ammo or { "ammo_none" }
    local wpn_tbl, ammo_tbl = {}, {}
    for _, faction in ipairs(LOOT_FACTIONS) do
        local wpns = wpn_raw[faction]
        local ammos = ammo_raw[faction]
        if wpns and ammos and #wpns == #ammos then
            wpn_tbl[faction] = wpns
            ammo_tbl[faction] = ammos
        else
            wpn_tbl[faction] = default_wpn
            ammo_tbl[faction] = default_ammo
        end
    end
    return wpn_tbl, ammo_tbl
end

function duty_girl_loot_get_weapon_table()
    local wpn_tbl, _ = build_weapon_ammo_tables()
    return wpn_tbl
end

function duty_girl_loot_get_ammo_table()
    local _, ammo_tbl = build_weapon_ammo_tables()
    return ammo_tbl
end

function duty_girl_loot_get_stuff_table() return read_faction_list_table("duty_girl_loot_stuff", "medkit") end

function table_length(tbl)
    local count = 0
    for _ in pairs(tbl) do
        count = count + 1
    end
    return count
end

function rnd_id_from_table(tbl)
    math.randomseed(os.time())
    local rnd_id = math.random(1, table_length(tbl))
    return rnd_id
end

--[[----------------------------------------------------------------------------------------------------
	duty_girl_capture_the_bridge
------------------------------------------------------------------------------------------------------]]
function duty_girl_capture_the_bridge_status(tsk, task_id)
    if tsk.stage == 0 then
        spawn_squad("red_smart_terrain_bridge", "squad_duty_girl_capture_the_bridge_mono_1")
        spawn_squad("red_smart_terrain_bridge", "squad_duty_girl_capture_the_bridge_mono_2")
        spawn_squad("red_smart_terrain_5_5", "squad_duty_girl_capture_the_bridge_duty")
        spawn_squad("red_smart_terrain_5_5", "squad_duty_girl_capture_the_bridge_lone")
        tsk.stage = 1
    end

    if (tsk.stage == 1) or (tsk.stage == 2) then
        local squad_1 = get_story_se_object("squad_duty_girl_capture_the_bridge_mono_1")
        local squad_2 = get_story_se_object("squad_duty_girl_capture_the_bridge_mono_2")
        local mem_num = squad_count(squad_1) + squad_count(squad_2)
        if mem_num ~= 0 then
            -- Player attack without order
            if mem_num < 20 then
                if NI("duty_girl_capture_the_bridge_move") then
                    GI("duty_girl_capture_the_bridge_move")
                    if NI("duty_girl_capture_the_bridge_join") then GI("duty_girl_capture_the_bridge_join") end

                    local message = make_speech_sequence({
                        { "duty_girl_capture_the_bridge_move_5", 5 },
                        { "duty_girl_capture_the_bridge_move_6", 5 },
                    })
                    local npc = get_story_object("stalker_duty_girl")
                    if npc then CreateTimeEvent(npc:id(), "speech", 0, message) end
                end
            end
        else
            -- Squad is killed
            local message = make_speech_sequence({ { "duty_girl_capture_the_bridge_move_4", 5 } })
            local npc = get_story_object("stalker_duty_girl")
            if npc then CreateTimeEvent(npc:id(), "speech", 0, message) end
            tsk.stage = 3
        end

        if tsk.stage == 1 then
            if HI("duty_girl_capture_the_bridge_move") then tsk.stage = 2 end
        end
    end

    if tsk.stage == 3 then
        if NI("red_bridge_outpost") then GI("red_bridge_outpost") end
        if NI("duty_girl_capture_the_bridge_dead") then GI("duty_girl_capture_the_bridge_dead") end
        if HI("duty_girl_capture_the_bridge_reward") then return "complete" end
    end
end

function duty_girl_capture_the_bridge_target(task_id, field, p, tsk)
    if field == "title" then return task_id .. "_" .. field end

    if field == "descr" then
        if (tsk.stage == 0) or (tsk.stage == 1) then return task_id .. "_" .. field .. "_1" end
        if tsk.stage == 2 then return task_id .. "_" .. field .. "_2" end
        if tsk.stage == 3 then return task_id .. "_" .. field .. "_3" end
    end

    if field == "target" then
        if (tsk.stage == 0) or (tsk.stage == 1) then
            local obj = get_story_se_object("squad_duty_girl")
            local sqd = get_story_se_object("squad_duty_girl_capture_the_bridge_duty")
            if obj and sqd and simulation_objects.is_on_the_same_level(obj, sqd) then return obj.id end
            return sqd and sqd.id
        end
        if tsk.stage == 2 then
            local obj = SIMBOARD.smarts_by_names["red_smart_terrain_bridge"]
            return obj and obj.id
        end
        if tsk.stage == 3 then
            local obj = get_story_se_object("squad_duty_girl")
            return obj and obj.id
        end
    end
end

function capture_the_bridge_hit(npc, shit, bone_id, flags)
    if shit and shit.draftsman and IsStalker(shit.draftsman) then
        local npc_squad = get_object_squad(npc)
        local hit_squad = (shit.draftsman:id() ~= AC_ID) and get_object_squad(shit.draftsman)
        if npc_squad and string.find(npc_squad:section_name(), "squad_duty_girl_capture_the_bridge_mono", 1, true) then
            if shit.draftsman:id() == AC_ID then return end
            if
                shit.draftsman:has_info("npcx_is_companion")
                or string.find(shit.draftsman:name(), "stalker_duty_girl", 1, true)
            then
                shit.power = shit.power / 3
                return
            end
            if hit_squad and string.find(hit_squad:section_name(), "squad_duty_girl_capture_the_bridge", 1, true) then
                shit.power = shit.power / 3
                return
            end
        else
            if hit_squad and string.find(hit_squad:section_name(), "squad_duty_girl_capture_the_bridge", 1, true) then
                shit.power = shit.power / 3
                return
            end
        end
    end
    flags.ret_value = false
end

function capture_the_bridge_spawn_outpost(actor, squad, p)
    local lst = {
        "squad_red_duty_outpost_trader",
        "squad_red_duty_outpost_medic",
        "squad_red_duty_outpost_guide",
        "squad_red_duty_outpost_guard_1",
        "squad_red_duty_outpost_guard_2",
        "squad_red_duty_outpost_visitor_1",
        "squad_red_duty_outpost_visitor_2",
        "squad_red_duty_outpost_visitor_3",
        "squad_red_duty_outpost_visitor_4",
    }
    for k, sec in pairs(lst) do
        if not (get_story_se_object(sec)) then spawn_squad("red_smart_terrain_bridge", sec) end
    end
end

