	Campfire
------------------------------------------------------------------------------------------------------]]
local storage_camp = {}

function generate_campfire_point(smart_name, campfire_name)
    local function itr(obj)
        local cf = {}
        local pos = obj:position()
        local dir = obj:direction()
        if pos and dir then
        end

